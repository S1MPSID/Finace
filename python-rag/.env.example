MONGO_URI=mongodb+srv://USER:PASS@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB=compliance_engine

# Google Gemini 2.5 Flash (primary LLM)
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
RAG_ENABLE_LLM=1

EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
# Render free tier: EMBEDDING_BACKEND=fastembed, RAG_LIGHT_XAI=1, RETRIEVAL_MAX_CANDIDATES=500
EMBEDDING_BACKEND=fastembed
RAG_LIGHT_XAI=0
RETRIEVAL_MAX_CANDIDATES=600

PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

BLOCKCHAIN_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_PROJECT_ID
COMPLIANCE_CONTRACT_ADDRESS=
